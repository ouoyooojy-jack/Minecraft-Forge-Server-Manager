{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mc Server Manager",
  "version": "0.1.1",
  "identifier": "com.mcservermanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mc Server Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ouoyooojy-jack/Minecraft-Forge-Server-Manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQjAwRDNCMTBFQTJEODQKUldTRUxlb1FPdzJ3bWxIYUlzNWJTUkdXcTFXZlBqSWs5SXlBZnlPK1k5M2tMSzYvTDYwNktzMFkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
