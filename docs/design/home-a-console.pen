{
  "version": "2.14",
  "themes": { "mode": ["dark"] },
  "_note": "Style A — Console. Warm charcoal instead of neutral near-black, one phosphor-green accent, and rows instead of cards. A server manager is a monitoring tool: a row can carry version, players, memory and uptime at a glance, where a 317x196 card carries a name and three icons. Dense on purpose.",
  "variables": {
    "color.bg":         { "type": "color", "value": "#12110F" },
    "color.rail":       { "type": "color", "value": "#0D0C0A" },
    "color.surface":    { "type": "color", "value": "#1B1916" },
    "color.surface_2":  { "type": "color", "value": "#242119" },
    "color.border":     { "type": "color", "value": "#2E2A25" },
    "color.fg":         { "type": "color", "value": "#EDE8E0" },
    "color.muted":      { "type": "color", "value": "#8C857A" },
    "color.accent":     { "type": "color", "value": "#7EE787" },
    "color.accent_fg":  { "type": "color", "value": "#12110F" },
    "color.amber":      { "type": "color", "value": "#E3B341" },
    "color.red":        { "type": "color", "value": "#F87171" },
    "color.grey":       { "type": "color", "value": "#6B655C" },

    "font.size.hero":   { "type": "number", "value": 26 },
    "font.size.row":    { "type": "number", "value": 17 },
    "font.size.body":   { "type": "number", "value": 14 },
    "font.size.small":  { "type": "number", "value": 12 },
    "font.size.tiny":   { "type": "number", "value": 11 },

    "radius.sm":        { "type": "number", "value": 4 },
    "radius.md":        { "type": "number", "value": 6 },
    "gap.row":          { "type": "number", "value": 8 },
    "sidebar.width":    { "type": "number", "value": 56 },
    "titlebar.height":  { "type": "number", "value": 34 }
  },
  "children": [
    {
      "id": "window",
      "type": "frame",
      "theme": { "mode": "dark" },
      "fill": "$color.bg",
      "x": 0, "y": 0,
      "width": 1280, "height": 720,
      "layout": "vertical",
      "padding": 0,
      "gap": 0,
      "children": [
        {
          "id": "title-bar",
          "type": "frame",
          "fill": "$color.bg",
          "width": "fill_container",
          "height": "$titlebar.height",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "padding": [0, 12, 0, 14],
          "children": [
            { "id": "tb-name", "type": "text", "content": "mc-server-manager", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
            {
              "id": "tb-controls", "type": "frame", "layout": "horizontal", "gap": 14, "alignItems": "center",
              "children": [
                { "id": "tb-sun", "type": "icon", "library": "lucide", "icon": "sun",   "width": 14, "height": 14, "fill": "$color.muted" },
                { "id": "tb-min", "type": "icon", "library": "lucide", "icon": "minus", "width": 14, "height": 14, "fill": "$color.muted" },
                { "id": "tb-max", "type": "icon", "library": "lucide", "icon": "square","width": 12, "height": 12, "fill": "$color.muted" },
                { "id": "tb-x",   "type": "icon", "library": "lucide", "icon": "x",     "width": 14, "height": 14, "fill": "$color.muted" }
              ]
            }
          ]
        },
        {
          "id": "body",
          "type": "frame",
          "width": "fill_container", "height": "fill_container",
          "layout": "horizontal", "gap": 0,
          "children": [
            {
              "id": "sidebar",
              "type": "frame",
              "fill": "$color.rail",
              "width": "$sidebar.width", "height": "fill_container",
              "layout": "vertical", "alignItems": "center",
              "padding": [16, 0, 16, 0], "gap": 16,
              "stroke": "$color.border", "strokeWidth": { "right": 1 },
              "children": [
                { "id": "sb-menu",     "type": "icon", "library": "lucide", "icon": "menu",     "width": 18, "height": 18, "fill": "$color.muted" },
                { "id": "sb-spacer",   "type": "frame", "width": 20, "height": 8 },
                { "id": "sb-home",     "type": "icon", "library": "lucide", "icon": "house",    "width": 19, "height": 19, "fill": "$color.accent" },
                { "id": "sb-download", "type": "icon", "library": "lucide", "icon": "download", "width": 19, "height": 19, "fill": "$color.muted" },
                { "id": "sb-settings", "type": "icon", "library": "lucide", "icon": "settings", "width": 19, "height": 19, "fill": "$color.muted" }
              ]
            },
            {
              "id": "content",
              "type": "frame",
              "fill": "$color.bg",
              "width": "fill_container", "height": "fill_container",
              "layout": "vertical", "padding": [22, 26, 18, 26], "gap": 20,
              "children": [
                {
                  "id": "header", "type": "frame", "width": "fill_container",
                  "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
                  "children": [
                    {
                      "id": "header-text", "type": "frame", "layout": "vertical", "gap": 3,
                      "children": [
                        { "id": "h-title", "type": "text", "content": "SERVERS", "fill": "$color.fg", "fontSize": "$font.size.hero", "fontWeight": "700", "textGrowth": "auto" },
                        { "id": "h-sub",   "type": "text", "content": "4 configured   ·   1 running   ·   25565 open", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" }
                      ]
                    },
                    {
                      "id": "new-button", "type": "frame",
                      "fill": "$color.accent", "cornerRadius": "$radius.md",
                      "height": 34, "padding": [0, 14, 0, 12],
                      "layout": "horizontal", "gap": 7, "alignItems": "center",
                      "children": [
                        { "id": "nb-icon",  "type": "icon", "library": "lucide", "icon": "plus", "width": 15, "height": 15, "fill": "$color.accent_fg" },
                        { "id": "nb-label", "type": "text", "content": "new server", "fill": "$color.accent_fg", "fontSize": "$font.size.body", "fontWeight": "600", "textGrowth": "auto" }
                      ]
                    }
                  ]
                },

                {
                  "id": "rows", "type": "frame", "width": "fill_container",
                  "layout": "vertical", "gap": "$gap.row",
                  "children": [
                    {
                      "id": "row-1", "type": "frame",
                      "fill": "$color.surface", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": "$radius.md",
                      "width": "fill_container", "height": 66,
                      "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
                      "padding": [0, 16, 0, 0],
                      "children": [
                        {
                          "id": "r1-left", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 16,
                          "children": [
                            { "id": "r1-bar", "type": "frame", "fill": "$color.accent", "width": 3, "height": 66, "cornerRadius": 2 },
                            {
                              "id": "r1-name-block", "type": "frame", "layout": "vertical", "gap": 3, "width": 230,
                              "children": [
                                { "id": "r1-name", "type": "text", "content": "survival", "fill": "$color.fg", "fontSize": "$font.size.row", "fontWeight": "600", "textGrowth": "auto" },
                                { "id": "r1-ver",  "type": "text", "content": "1.20.1  ·  forge 47.2.0", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" }
                              ]
                            },
                            {
                              "id": "r1-chip", "type": "frame",
                              "fill": "$color.surface_2", "cornerRadius": "$radius.sm",
                              "height": 24, "padding": [0, 10, 0, 8],
                              "layout": "horizontal", "gap": 7, "alignItems": "center",
                              "children": [
                                { "id": "r1-dot",   "type": "icon", "library": "lucide", "icon": "circle", "width": 8, "height": 8, "fill": "$color.accent" },
                                { "id": "r1-state", "type": "text", "content": "online", "fill": "$color.accent", "fontSize": "$font.size.tiny", "fontWeight": "600", "textGrowth": "auto" }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "r1-right", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 28,
                          "children": [
                            { "id": "r1-m1", "type": "frame", "layout": "vertical", "gap": 2, "width": 74, "children": [
                              { "id": "r1-m1l", "type": "text", "content": "PLAYERS", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r1-m1v", "type": "text", "content": "12 / 20",  "fill": "$color.fg",    "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r1-m2", "type": "frame", "layout": "vertical", "gap": 2, "width": 92, "children": [
                              { "id": "r1-m2l", "type": "text", "content": "MEMORY",  "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r1-m2v", "type": "text", "content": "3.2 / 4 GB", "fill": "$color.fg", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r1-m3", "type": "frame", "layout": "vertical", "gap": 2, "width": 78, "children": [
                              { "id": "r1-m3l", "type": "text", "content": "UPTIME",  "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r1-m3v", "type": "text", "content": "4h 12m",  "fill": "$color.fg",    "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r1-actions", "type": "frame", "layout": "horizontal", "gap": 14, "alignItems": "center", "children": [
                              { "id": "r1-a1", "type": "icon", "library": "lucide", "icon": "terminal",           "width": 17, "height": 17, "fill": "$color.fg" },
                              { "id": "r1-a2", "type": "icon", "library": "lucide", "icon": "sliders-horizontal", "width": 17, "height": 17, "fill": "$color.muted" },
                              { "id": "r1-a3", "type": "icon", "library": "lucide", "icon": "square",             "width": 15, "height": 15, "fill": "$color.muted" }
                            ]}
                          ]
                        }
                      ]
                    },

                    {
                      "id": "row-2", "type": "frame",
                      "fill": "$color.surface", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": "$radius.md",
                      "width": "fill_container", "height": 66,
                      "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
                      "padding": [0, 16, 0, 0],
                      "children": [
                        {
                          "id": "r2-left", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 16,
                          "children": [
                            { "id": "r2-bar", "type": "frame", "fill": "$color.amber", "width": 3, "height": 66, "cornerRadius": 2 },
                            { "id": "r2-name-block", "type": "frame", "layout": "vertical", "gap": 3, "width": 230, "children": [
                              { "id": "r2-name", "type": "text", "content": "creative-flat", "fill": "$color.fg", "fontSize": "$font.size.row", "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r2-ver",  "type": "text", "content": "1.20.4  ·  forge 49.0.30", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" }
                            ]},
                            { "id": "r2-chip", "type": "frame", "fill": "$color.surface_2", "cornerRadius": "$radius.sm", "height": 24, "padding": [0, 10, 0, 8], "layout": "horizontal", "gap": 7, "alignItems": "center", "children": [
                              { "id": "r2-dot",   "type": "icon", "library": "lucide", "icon": "circle", "width": 8, "height": 8, "fill": "$color.amber" },
                              { "id": "r2-state", "type": "text", "content": "starting", "fill": "$color.amber", "fontSize": "$font.size.tiny", "fontWeight": "600", "textGrowth": "auto" }
                            ]}
                          ]
                        },
                        {
                          "id": "r2-right", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 28,
                          "children": [
                            { "id": "r2-m1", "type": "frame", "layout": "vertical", "gap": 2, "width": 74, "children": [
                              { "id": "r2-m1l", "type": "text", "content": "PLAYERS", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r2-m1v", "type": "text", "content": "—", "fill": "$color.grey", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r2-m2", "type": "frame", "layout": "vertical", "gap": 2, "width": 92, "children": [
                              { "id": "r2-m2l", "type": "text", "content": "MEMORY", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r2-m2v", "type": "text", "content": "0.9 / 2 GB", "fill": "$color.fg", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r2-m3", "type": "frame", "layout": "vertical", "gap": 2, "width": 78, "children": [
                              { "id": "r2-m3l", "type": "text", "content": "UPTIME", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r2-m3v", "type": "text", "content": "12s", "fill": "$color.fg", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r2-actions", "type": "frame", "layout": "horizontal", "gap": 14, "alignItems": "center", "children": [
                              { "id": "r2-a1", "type": "icon", "library": "lucide", "icon": "terminal",           "width": 17, "height": 17, "fill": "$color.fg" },
                              { "id": "r2-a2", "type": "icon", "library": "lucide", "icon": "sliders-horizontal", "width": 17, "height": 17, "fill": "$color.muted" },
                              { "id": "r2-a3", "type": "icon", "library": "lucide", "icon": "square",             "width": 15, "height": 15, "fill": "$color.muted" }
                            ]}
                          ]
                        }
                      ]
                    },

                    {
                      "id": "row-3", "type": "frame",
                      "fill": "$color.surface", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": "$radius.md",
                      "width": "fill_container", "height": 66,
                      "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
                      "padding": [0, 16, 0, 0],
                      "children": [
                        {
                          "id": "r3-left", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 16,
                          "children": [
                            { "id": "r3-bar", "type": "frame", "fill": "$color.grey", "width": 3, "height": 66, "cornerRadius": 2 },
                            { "id": "r3-name-block", "type": "frame", "layout": "vertical", "gap": 3, "width": 230, "children": [
                              { "id": "r3-name", "type": "text", "content": "modpack-atm9", "fill": "$color.fg", "fontSize": "$font.size.row", "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r3-ver",  "type": "text", "content": "1.20.1  ·  forge 47.2.20", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" }
                            ]},
                            { "id": "r3-chip", "type": "frame", "fill": "$color.surface_2", "cornerRadius": "$radius.sm", "height": 24, "padding": [0, 10, 0, 8], "layout": "horizontal", "gap": 7, "alignItems": "center", "children": [
                              { "id": "r3-dot",   "type": "icon", "library": "lucide", "icon": "circle", "width": 8, "height": 8, "fill": "$color.grey" },
                              { "id": "r3-state", "type": "text", "content": "offline", "fill": "$color.muted", "fontSize": "$font.size.tiny", "fontWeight": "600", "textGrowth": "auto" }
                            ]}
                          ]
                        },
                        {
                          "id": "r3-right", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 28,
                          "children": [
                            { "id": "r3-m1", "type": "frame", "layout": "vertical", "gap": 2, "width": 74, "children": [
                              { "id": "r3-m1l", "type": "text", "content": "PLAYERS", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r3-m1v", "type": "text", "content": "—", "fill": "$color.grey", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r3-m2", "type": "frame", "layout": "vertical", "gap": 2, "width": 92, "children": [
                              { "id": "r3-m2l", "type": "text", "content": "MEMORY", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r3-m2v", "type": "text", "content": "— / 8 GB", "fill": "$color.grey", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r3-m3", "type": "frame", "layout": "vertical", "gap": 2, "width": 78, "children": [
                              { "id": "r3-m3l", "type": "text", "content": "UPTIME", "fill": "$color.muted", "fontSize": 9, "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r3-m3v", "type": "text", "content": "—", "fill": "$color.grey", "fontSize": "$font.size.body", "textGrowth": "auto" }
                            ]},
                            { "id": "r3-actions", "type": "frame", "layout": "horizontal", "gap": 14, "alignItems": "center", "children": [
                              { "id": "r3-a1", "type": "icon", "library": "lucide", "icon": "play",               "width": 16, "height": 16, "fill": "$color.accent" },
                              { "id": "r3-a2", "type": "icon", "library": "lucide", "icon": "sliders-horizontal", "width": 17, "height": 17, "fill": "$color.muted" },
                              { "id": "r3-a3", "type": "icon", "library": "lucide", "icon": "trash-2",            "width": 16, "height": 16, "fill": "$color.muted" }
                            ]}
                          ]
                        }
                      ]
                    },

                    {
                      "id": "row-4", "type": "frame",
                      "fill": "$color.surface", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": "$radius.md",
                      "width": "fill_container", "height": 66,
                      "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
                      "padding": [0, 16, 0, 0],
                      "children": [
                        {
                          "id": "r4-left", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 16,
                          "children": [
                            { "id": "r4-bar", "type": "frame", "fill": "$color.red", "width": 3, "height": 66, "cornerRadius": 2 },
                            { "id": "r4-name-block", "type": "frame", "layout": "vertical", "gap": 3, "width": 230, "children": [
                              { "id": "r4-name", "type": "text", "content": "test-1.21", "fill": "$color.fg", "fontSize": "$font.size.row", "fontWeight": "600", "textGrowth": "auto" },
                              { "id": "r4-ver",  "type": "text", "content": "1.21.4  ·  forge 54.1.0", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" }
                            ]},
                            { "id": "r4-chip", "type": "frame", "fill": "$color.surface_2", "cornerRadius": "$radius.sm", "height": 24, "padding": [0, 10, 0, 8], "layout": "horizontal", "gap": 7, "alignItems": "center", "children": [
                              { "id": "r4-dot",   "type": "icon", "library": "lucide", "icon": "circle", "width": 8, "height": 8, "fill": "$color.red" },
                              { "id": "r4-state", "type": "text", "content": "crashed · exit 1", "fill": "$color.red", "fontSize": "$font.size.tiny", "fontWeight": "600", "textGrowth": "auto" }
                            ]}
                          ]
                        },
                        {
                          "id": "r4-right", "type": "frame", "layout": "horizontal", "alignItems": "center", "gap": 28,
                          "children": [
                            { "id": "r4-hint", "type": "text", "content": "查看主控台了解原因", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                            { "id": "r4-actions", "type": "frame", "layout": "horizontal", "gap": 14, "alignItems": "center", "children": [
                              { "id": "r4-a1", "type": "icon", "library": "lucide", "icon": "terminal",           "width": 17, "height": 17, "fill": "$color.red" },
                              { "id": "r4-a2", "type": "icon", "library": "lucide", "icon": "sliders-horizontal", "width": 17, "height": 17, "fill": "$color.muted" },
                              { "id": "r4-a3", "type": "icon", "library": "lucide", "icon": "trash-2",            "width": 16, "height": 16, "fill": "$color.muted" }
                            ]}
                          ]
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "hint-bar", "type": "frame",
                  "width": "fill_container",
                  "layout": "horizontal", "gap": 22, "alignItems": "center",
                  "padding": [10, 0, 0, 0],
                  "stroke": "$color.border", "strokeWidth": { "top": 1 },
                  "children": [
                    { "id": "hint-1", "type": "text", "content": "↵  開啟主控台",       "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                    { "id": "hint-2", "type": "text", "content": "N  新增伺服器",       "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                    { "id": "hint-3", "type": "text", "content": "⌘K  搜尋",           "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                    { "id": "hint-4", "type": "text", "content": "S  啟動 / 停止",     "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
