                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "icon",
                                  "id": "c1-dot",
                                  "width": 8,
                                  "height": 8,
                                  "icon": "circle",
                                  "library": "lucide",
                                  "fill": "$color.green"
                                },
                                {
                                  "type": "text",
                                  "id": "c1-state",
                                  "fill": "$color.green",
                                  "content": "執行中",
