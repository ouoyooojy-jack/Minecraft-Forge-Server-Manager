{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "window",
      "x": 0,
      "y": 0,
      "theme": {
        "mode": "light"
      },
      "width": 1280,
      "height": 720,
      "fill": "$color.bg",
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "title-bar",
          "width": "fill_container",
          "fill": "$color.bg",
          "padding": [
            0,
            14,
            0,
            18
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "tb-name",
              "fill": "$color.muted",
              "content": "Mc Server Manager",
              "fontFamily": "Inter",
              "fontSize": "$font.size.small",
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "tb-controls",
              "gap": 18,
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "tb-moon",
                  "width": 15,
                  "height": 15,
                  "icon": "moon",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "tb-min",
                  "width": 15,
                  "height": 15,
                  "icon": "minus",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "tb-max",
                  "width": 13,
                  "height": 13,
                  "icon": "square",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "tb-x",
                  "width": 15,
                  "height": 15,
                  "icon": "x",
                  "library": "lucide",
                  "fill": "$color.muted"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "body",
          "width": "fill_container",
          "height": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "sidebar",
              "height": "fill_container",
              "fill": "$color.rail",
              "layout": "vertical",
              "gap": 10,
              "padding": [
                18,
                0
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "sb-menu",
                  "width": 19,
                  "height": 19,
                  "icon": "menu",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "frame",
                  "id": "sb-gap",
                  "width": 20,
                  "height": 10
                },
                {
                  "type": "frame",
                  "id": "sb-home-pill",
                  "width": 40,
                  "height": 40,
                  "fill": "$color.surface",
                  "cornerRadius": "$radius.button",
                  "stroke": "$color.border",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "sb-home",
                      "width": 19,
                      "height": 19,
                      "icon": "house",
                      "library": "lucide",
                      "fill": "$color.accent"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "sb-dl-pill",
                  "width": 40,
                  "height": 40,
                  "layout": "vertical",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "sb-download",
                      "width": 19,
                      "height": 19,
                      "icon": "download",
                      "library": "lucide",
                      "fill": "$color.muted"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "sb-set-pill",
                  "width": 40,
                  "height": 40,
                  "layout": "vertical",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "sb-settings",
                      "width": 19,
                      "height": 19,
                      "icon": "settings",
                      "library": "lucide",
                      "fill": "$color.muted"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "content",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.bg",
              "layout": "vertical",
              "gap": 28,
              "padding": [
                34,
                40,
                28,
                40
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "header",
                  "width": "fill_container",
                  "justifyContent": "space_between",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "header-text",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "h-title",
                          "fill": "$color.fg",
                          "content": "Forge Server Manager",
                          "fontFamily": "Inter",
                          "fontSize": "$font.size.hero",
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "new-button",
                      "height": 42,
                      "fill": "$color.accent",
                      "cornerRadius": "$radius.button",
                      "gap": 8,
                      "padding": [
                        0,
                        20,
                        0,
                        16
                      ],
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon",
                          "id": "nb-icon",
                          "width": 17,
                          "height": 17,
                          "icon": "chevron-down",
                          "library": "lucide",
                          "fill": "$color.accent_fg"
                        },
                        {
                          "type": "text",
                          "id": "nb-label",
                          "fill": "$color.accent_fg",
                          "content": "新增伺服器",
                          "fontFamily": "Inter",
                          "fontSize": "$font.size.body",
                          "fontWeight": "600"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "cards",
                  "width": "fill_container",
                  "gap": "$gap.card",
                  "children": [
                    {
                      "type": "frame",
                      "id": "card-1",
                      "width": 262,
                      "height": 208,
                      "fill": "$color.surface",
                      "cornerRadius": "$radius.card",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "layout": "vertical",
                      "padding": 20,
                      "justifyContent": "space_between",
                      "children": [
                        {
                          "type": "frame",
                          "id": "c1-top",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 14,
                          "children": [
                            {
                              "type": "frame",
                              "id": "c1-badge",
                              "height": 26,
                              "fill": "$color.green_soft",
