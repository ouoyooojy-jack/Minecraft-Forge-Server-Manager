                                  "type": "text",
                                  "id": "c1-meta",
                                  "fill": "$color.muted",
                                  "content": "1.20.1 · Forge 47.2.0",
                                  "fontFamily": "Inter",
                                  "fontSize": "$font.size.small",
                                  "fontWeight": "normal"
