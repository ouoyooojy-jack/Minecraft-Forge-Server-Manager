{
  "version": "2.14",
  "themes": { "mode": ["dark"] },
  "_note": "Style C — Glass. Dark, but blue-violet rather than neutral grey, with a saturated indigo accent doing real work. Layered translucent panels over the Mica backdrop, 20px radii, and a colour-coded left edge per card. The glossiest of the three; leans product rather than tool.",
  "variables": {
    "color.bg":          { "type": "color", "value": "#0B0B14" },
    "color.rail":        { "type": "color", "value": "#FFFFFF08" },
    "color.glass":       { "type": "color", "value": "#FFFFFF0A" },
    "color.glass_hi":    { "type": "color", "value": "#FFFFFF12" },
    "color.border":      { "type": "color", "value": "#FFFFFF16" },
    "color.fg":          { "type": "color", "value": "#ECECFF" },
    "color.muted":       { "type": "color", "value": "#8A8AB4" },
    "color.accent":      { "type": "color", "value": "#7C5CFF" },
    "color.accent_fg":   { "type": "color", "value": "#FFFFFF" },
    "color.accent_soft": { "type": "color", "value": "#7C5CFF26" },
    "color.green":       { "type": "color", "value": "#3DDC97" },
    "color.green_soft":  { "type": "color", "value": "#3DDC9722" },
    "color.amber":       { "type": "color", "value": "#FFB84D" },
    "color.amber_soft":  { "type": "color", "value": "#FFB84D22" },
    "color.red":         { "type": "color", "value": "#FF6B81" },
    "color.grey":        { "type": "color", "value": "#5A5A78" },

    "font.size.hero":    { "type": "number", "value": 30 },
    "font.size.card":    { "type": "number", "value": 20 },
    "font.size.body":    { "type": "number", "value": 14 },
    "font.size.small":   { "type": "number", "value": 12 },
    "font.size.tiny":    { "type": "number", "value": 11 },

    "radius.card":       { "type": "number", "value": 20 },
    "radius.button":     { "type": "number", "value": 12 },
    "radius.pill":       { "type": "number", "value": 999 },
    "gap.card":          { "type": "number", "value": 20 },
    "sidebar.width":     { "type": "number", "value": 60 },
    "titlebar.height":   { "type": "number", "value": 36 }
  },
  "children": [
    {
      "id": "window",
      "type": "frame",
      "theme": { "mode": "dark" },
      "fill": "$color.bg",
      "x": 0, "y": 0,
      "width": 1280, "height": 720,
      "layout": "vertical", "padding": 0, "gap": 0,
      "children": [
        {
          "id": "title-bar", "type": "frame",
          "width": "fill_container", "height": "$titlebar.height",
          "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
          "padding": [0, 12, 0, 18],
          "children": [
            { "id": "tb-name", "type": "text", "content": "Mc Server Manager", "fill": "$color.muted", "fontSize": "$font.size.small", "textGrowth": "auto" },
            {
              "id": "tb-controls", "type": "frame", "layout": "horizontal", "gap": 18, "alignItems": "center",
              "children": [
                { "id": "tb-sun", "type": "icon", "library": "lucide", "icon": "sun",   "width": 15, "height": 15, "fill": "$color.muted" },
                { "id": "tb-min", "type": "icon", "library": "lucide", "icon": "minus", "width": 15, "height": 15, "fill": "$color.muted" },
                { "id": "tb-max", "type": "icon", "library": "lucide", "icon": "square","width": 13, "height": 13, "fill": "$color.muted" },
                { "id": "tb-x",   "type": "icon", "library": "lucide", "icon": "x",     "width": 15, "height": 15, "fill": "$color.muted" }
              ]
            }
          ]
        },
        {
          "id": "body", "type": "frame",
          "width": "fill_container", "height": "fill_container",
          "layout": "horizontal", "gap": 0,
          "children": [
            {
              "id": "sidebar", "type": "frame",
              "fill": "$color.rail",
              "width": "$sidebar.width", "height": "fill_container",
              "layout": "vertical", "alignItems": "center",
              "padding": [16, 0, 16, 0], "gap": 8,
              "stroke": "$color.border", "strokeWidth": { "right": 1 },
              "children": [
                { "id": "sb-menu", "type": "icon", "library": "lucide", "icon": "menu", "width": 19, "height": 19, "fill": "$color.muted" },
                { "id": "sb-gap", "type": "frame", "width": 20, "height": 12 },
                {
                  "id": "sb-home-pill", "type": "frame",
                  "fill": "$color.accent_soft", "cornerRadius": "$radius.button",
                  "width": 40, "height": 40,
                  "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                  "children": [
                    { "id": "sb-home", "type": "icon", "library": "lucide", "icon": "house", "width": 19, "height": 19, "fill": "$color.accent" }
                  ]
                },
                {
                  "id": "sb-dl-pill", "type": "frame", "width": 40, "height": 40,
                  "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                  "children": [
                    { "id": "sb-download", "type": "icon", "library": "lucide", "icon": "download", "width": 19, "height": 19, "fill": "$color.muted" }
                  ]
                },
                {
                  "id": "sb-set-pill", "type": "frame", "width": 40, "height": 40,
                  "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                  "children": [
                    { "id": "sb-settings", "type": "icon", "library": "lucide", "icon": "settings", "width": 19, "height": 19, "fill": "$color.muted" }
                  ]
                }
              ]
            },
            {
              "id": "content", "type": "frame",
              "width": "fill_container", "height": "fill_container",
              "layout": "vertical", "padding": [30, 34, 26, 34], "gap": 24,
              "children": [
                {
                  "id": "header", "type": "frame", "width": "fill_container",
                  "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
                  "children": [
                    {
                      "id": "header-text", "type": "frame", "layout": "vertical", "gap": 5,
                      "children": [
                        { "id": "h-title", "type": "text", "content": "Servers", "fill": "$color.fg", "fontSize": "$font.size.hero", "fontWeight": "700", "textGrowth": "auto" },
                        { "id": "h-sub",   "type": "text", "content": "1 running · 3 total", "fill": "$color.muted", "fontSize": "$font.size.small", "textGrowth": "auto" }
                      ]
                    },
                    {
                      "id": "header-right", "type": "frame", "layout": "horizontal", "gap": 12, "alignItems": "center",
                      "children": [
                        {
                          "id": "filter", "type": "frame",
                          "fill": "$color.glass", "cornerRadius": "$radius.pill",
                          "stroke": "$color.border", "strokeWidth": 1,
                          "height": 38, "padding": [4, 4, 4, 4],
                          "layout": "horizontal", "gap": 4, "alignItems": "center",
                          "children": [
                            {
                              "id": "f-all", "type": "frame", "fill": "$color.glass_hi", "cornerRadius": "$radius.pill",
                              "height": 30, "padding": [0, 14, 0, 14],
                              "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                              "children": [
                                { "id": "f-all-l", "type": "text", "content": "全部", "fill": "$color.fg", "fontSize": "$font.size.small", "fontWeight": "600", "textGrowth": "auto" }
                              ]
                            },
                            {
                              "id": "f-run", "type": "frame", "height": 30, "padding": [0, 14, 0, 14],
                              "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                              "children": [
                                { "id": "f-run-l", "type": "text", "content": "執行中", "fill": "$color.muted", "fontSize": "$font.size.small", "textGrowth": "auto" }
                              ]
                            },
                            {
                              "id": "f-stop", "type": "frame", "height": 30, "padding": [0, 14, 0, 14],
                              "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                              "children": [
                                { "id": "f-stop-l", "type": "text", "content": "已停止", "fill": "$color.muted", "fontSize": "$font.size.small", "textGrowth": "auto" }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "new-button", "type": "frame",
                          "fill": "$color.accent", "cornerRadius": "$radius.button",
                          "height": 38, "padding": [0, 18, 0, 14],
                          "layout": "horizontal", "gap": 8, "alignItems": "center",
                          "children": [
                            { "id": "nb-icon",  "type": "icon", "library": "lucide", "icon": "plus", "width": 16, "height": 16, "fill": "$color.accent_fg" },
                            { "id": "nb-label", "type": "text", "content": "新增", "fill": "$color.accent_fg", "fontSize": "$font.size.body", "fontWeight": "600", "textGrowth": "auto" }
                          ]
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "cards", "type": "frame", "width": "fill_container",
                  "layout": "horizontal", "gap": "$gap.card",
                  "children": [
                    {
                      "id": "card-1", "type": "frame",
                      "fill": "$color.glass", "stroke": "$color.border", "strokeWidth": 1,
                      "cornerRadius": "$radius.card",
                      "width": 274, "height": 236,
                      "layout": "horizontal", "gap": 0,
                      "children": [
                        { "id": "c1-edge", "type": "frame", "fill": "$color.green", "width": 4, "height": "fill_container" },
                        {
                          "id": "c1-inner", "type": "frame",
                          "width": "fill_container", "height": "fill_container",
                          "layout": "vertical", "justifyContent": "space_between",
                          "padding": [20, 20, 20, 18],
                          "children": [
                            {
                              "id": "c1-top", "type": "frame", "layout": "vertical", "gap": 12, "width": "fill_container",
                              "children": [
                                {
                                  "id": "c1-badge", "type": "frame",
                                  "fill": "$color.green_soft", "cornerRadius": "$radius.pill",
                                  "height": 24, "padding": [0, 11, 0, 9],
                                  "layout": "horizontal", "gap": 6, "alignItems": "center",
                                  "children": [
                                    { "id": "c1-dot",  "type": "icon", "library": "lucide", "icon": "circle", "width": 7, "height": 7, "fill": "$color.green" },
                                    { "id": "c1-state","type": "text", "content": "ONLINE", "fill": "$color.green", "fontSize": 10, "fontWeight": "700", "textGrowth": "auto" }
                                  ]
                                },
                                { "id": "c1-name", "type": "text", "content": "survival", "fill": "$color.fg", "fontSize": "$font.size.card", "fontWeight": "600", "textGrowth": "auto" },
                                { "id": "c1-meta", "type": "text", "content": "1.20.1 · Forge 47.2.0", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                                {
                                  "id": "c1-stats", "type": "frame", "layout": "horizontal", "gap": 18, "width": "fill_container",
                                  "children": [
                                    { "id": "c1-s1", "type": "frame", "layout": "vertical", "gap": 1, "children": [
                                      { "id": "c1-s1v", "type": "text", "content": "12/20", "fill": "$color.fg", "fontSize": "$font.size.body", "fontWeight": "600", "textGrowth": "auto" },
                                      { "id": "c1-s1l", "type": "text", "content": "玩家",   "fill": "$color.muted", "fontSize": 10, "textGrowth": "auto" }
                                    ]},
                                    { "id": "c1-s2", "type": "frame", "layout": "vertical", "gap": 1, "children": [
                                      { "id": "c1-s2v", "type": "text", "content": "3.2 GB", "fill": "$color.fg", "fontSize": "$font.size.body", "fontWeight": "600", "textGrowth": "auto" },
                                      { "id": "c1-s2l", "type": "text", "content": "記憶體", "fill": "$color.muted", "fontSize": 10, "textGrowth": "auto" }
                                    ]},
                                    { "id": "c1-s3", "type": "frame", "layout": "vertical", "gap": 1, "children": [
                                      { "id": "c1-s3v", "type": "text", "content": "4h 12m", "fill": "$color.fg", "fontSize": "$font.size.body", "fontWeight": "600", "textGrowth": "auto" },
                                      { "id": "c1-s3l", "type": "text", "content": "運行",   "fill": "$color.muted", "fontSize": 10, "textGrowth": "auto" }
                                    ]}
                                  ]
                                }
                              ]
                            },
                            {
                              "id": "c1-actions", "type": "frame", "layout": "horizontal", "gap": 8, "width": "fill_container",
                              "children": [
                                {
                                  "id": "c1-console", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.button",
                                  "height": 34, "width": "fill_container",
                                  "layout": "horizontal", "gap": 7, "alignItems": "center", "justifyContent": "center",
                                  "children": [
                                    { "id": "c1-ci", "type": "icon", "library": "lucide", "icon": "terminal", "width": 14, "height": 14, "fill": "$color.fg" },
                                    { "id": "c1-cl", "type": "text", "content": "主控台", "fill": "$color.fg", "fontSize": "$font.size.small", "fontWeight": "600", "textGrowth": "auto" }
                                  ]
                                },
                                {
                                  "id": "c1-more", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.button",
                                  "height": 34, "width": 38,
                                  "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                                  "children": [
                                    { "id": "c1-mi", "type": "icon", "library": "lucide", "icon": "ellipsis", "width": 16, "height": 16, "fill": "$color.muted" }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },

                    {
                      "id": "card-2", "type": "frame",
                      "fill": "$color.glass", "stroke": "$color.border", "strokeWidth": 1,
                      "cornerRadius": "$radius.card",
                      "width": 274, "height": 236,
                      "layout": "horizontal", "gap": 0,
                      "children": [
                        { "id": "c2-edge", "type": "frame", "fill": "$color.amber", "width": 4, "height": "fill_container" },
                        {
                          "id": "c2-inner", "type": "frame",
                          "width": "fill_container", "height": "fill_container",
                          "layout": "vertical", "justifyContent": "space_between",
                          "padding": [20, 20, 20, 18],
                          "children": [
                            {
                              "id": "c2-top", "type": "frame", "layout": "vertical", "gap": 12, "width": "fill_container",
                              "children": [
                                {
                                  "id": "c2-badge", "type": "frame",
                                  "fill": "$color.amber_soft", "cornerRadius": "$radius.pill",
                                  "height": 24, "padding": [0, 11, 0, 9],
                                  "layout": "horizontal", "gap": 6, "alignItems": "center",
                                  "children": [
                                    { "id": "c2-dot",  "type": "icon", "library": "lucide", "icon": "circle", "width": 7, "height": 7, "fill": "$color.amber" },
                                    { "id": "c2-state","type": "text", "content": "STARTING", "fill": "$color.amber", "fontSize": 10, "fontWeight": "700", "textGrowth": "auto" }
                                  ]
                                },
                                { "id": "c2-name", "type": "text", "content": "creative-flat", "fill": "$color.fg", "fontSize": "$font.size.card", "fontWeight": "600", "textGrowth": "auto" },
                                { "id": "c2-meta", "type": "text", "content": "1.20.4 · Forge 49.0.30", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                                {
                                  "id": "c2-progress-wrap", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.pill",
                                  "width": "fill_container", "height": 6,
                                  "layout": "horizontal",
                                  "children": [
                                    { "id": "c2-progress", "type": "frame", "fill": "$color.amber", "cornerRadius": "$radius.pill", "width": 118, "height": 6 }
                                  ]
                                },
                                { "id": "c2-progress-label", "type": "text", "content": "載入世界 · 62%", "fill": "$color.muted", "fontSize": 10, "textGrowth": "auto" }
                              ]
                            },
                            {
                              "id": "c2-actions", "type": "frame", "layout": "horizontal", "gap": 8, "width": "fill_container",
                              "children": [
                                {
                                  "id": "c2-console", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.button",
                                  "height": 34, "width": "fill_container",
                                  "layout": "horizontal", "gap": 7, "alignItems": "center", "justifyContent": "center",
                                  "children": [
                                    { "id": "c2-ci", "type": "icon", "library": "lucide", "icon": "terminal", "width": 14, "height": 14, "fill": "$color.fg" },
                                    { "id": "c2-cl", "type": "text", "content": "主控台", "fill": "$color.fg", "fontSize": "$font.size.small", "fontWeight": "600", "textGrowth": "auto" }
                                  ]
                                },
                                {
                                  "id": "c2-more", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.button",
                                  "height": 34, "width": 38,
                                  "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                                  "children": [
                                    { "id": "c2-mi", "type": "icon", "library": "lucide", "icon": "ellipsis", "width": 16, "height": 16, "fill": "$color.muted" }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },

                    {
                      "id": "card-3", "type": "frame",
                      "fill": "$color.glass", "stroke": "$color.border", "strokeWidth": 1,
                      "cornerRadius": "$radius.card",
                      "width": 274, "height": 236,
                      "layout": "horizontal", "gap": 0,
                      "children": [
                        { "id": "c3-edge", "type": "frame", "fill": "$color.grey", "width": 4, "height": "fill_container" },
                        {
                          "id": "c3-inner", "type": "frame",
                          "width": "fill_container", "height": "fill_container",
                          "layout": "vertical", "justifyContent": "space_between",
                          "padding": [20, 20, 20, 18],
                          "children": [
                            {
                              "id": "c3-top", "type": "frame", "layout": "vertical", "gap": 12, "width": "fill_container",
                              "children": [
                                {
                                  "id": "c3-badge", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.pill",
                                  "height": 24, "padding": [0, 11, 0, 9],
                                  "layout": "horizontal", "gap": 6, "alignItems": "center",
                                  "children": [
                                    { "id": "c3-dot",  "type": "icon", "library": "lucide", "icon": "circle", "width": 7, "height": 7, "fill": "$color.grey" },
                                    { "id": "c3-state","type": "text", "content": "OFFLINE", "fill": "$color.muted", "fontSize": 10, "fontWeight": "700", "textGrowth": "auto" }
                                  ]
                                },
                                { "id": "c3-name", "type": "text", "content": "modpack-atm9", "fill": "$color.fg", "fontSize": "$font.size.card", "fontWeight": "600", "textGrowth": "auto" },
                                { "id": "c3-meta", "type": "text", "content": "1.20.1 · Forge 47.2.20", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textGrowth": "auto" },
                                { "id": "c3-last", "type": "text", "content": "上次執行 · 昨天 22:14", "fill": "$color.muted", "fontSize": 10, "textGrowth": "auto" }
                              ]
                            },
                            {
                              "id": "c3-actions", "type": "frame", "layout": "horizontal", "gap": 8, "width": "fill_container",
                              "children": [
                                {
                                  "id": "c3-start", "type": "frame",
                                  "fill": "$color.accent_soft", "cornerRadius": "$radius.button",
                                  "height": 34, "width": "fill_container",
                                  "layout": "horizontal", "gap": 7, "alignItems": "center", "justifyContent": "center",
                                  "children": [
                                    { "id": "c3-si", "type": "icon", "library": "lucide", "icon": "play", "width": 13, "height": 13, "fill": "$color.accent" },
                                    { "id": "c3-sl", "type": "text", "content": "啟動", "fill": "$color.accent", "fontSize": "$font.size.small", "fontWeight": "600", "textGrowth": "auto" }
                                  ]
                                },
                                {
                                  "id": "c3-more", "type": "frame",
                                  "fill": "$color.glass_hi", "cornerRadius": "$radius.button",
                                  "height": 34, "width": 38,
                                  "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                                  "children": [
                                    { "id": "c3-mi", "type": "icon", "library": "lucide", "icon": "ellipsis", "width": 16, "height": 16, "fill": "$color.muted" }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },

                    {
                      "id": "card-add", "type": "frame",
                      "fill": "$color.accent_soft", "stroke": "$color.accent", "strokeWidth": 1,
                      "cornerRadius": "$radius.card",
                      "width": 274, "height": 236,
                      "layout": "vertical", "alignItems": "center", "justifyContent": "center", "gap": 14,
                      "padding": 20,
                      "children": [
                        {
                          "id": "add-circle", "type": "frame",
                          "fill": "$color.accent", "cornerRadius": "$radius.pill",
                          "width": 52, "height": 52,
                          "layout": "vertical", "alignItems": "center", "justifyContent": "center",
                          "children": [
                            { "id": "add-icon", "type": "icon", "library": "lucide", "icon": "plus", "width": 24, "height": 24, "fill": "$color.accent_fg" }
                          ]
                        },
                        { "id": "add-label", "type": "text", "content": "新增伺服器", "fill": "$color.fg", "fontSize": "$font.size.body", "fontWeight": "600", "textAlign": "center", "textGrowth": "auto" },
                        { "id": "add-sub",   "type": "text", "content": "選擇 Forge 版本並安裝", "fill": "$color.muted", "fontSize": "$font.size.tiny", "textAlign": "center", "textGrowth": "auto" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
