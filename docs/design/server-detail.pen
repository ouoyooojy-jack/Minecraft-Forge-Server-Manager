                          "fill": "$color.muted",
                          "content": "記憶體",
                          "fontFamily": "Inter",
                          "fontSize": "$font.size.tiny",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "c-stat-mem-val",
                          "gap": 5,
