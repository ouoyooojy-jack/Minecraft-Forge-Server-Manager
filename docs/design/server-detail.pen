                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "c-tabs",
                  "width": "fill_container",
                  "height": 33,
                  "alignItems": "end",
                  "children": [
                    {
                      "type": "frame",
                      "id": "c-tabs-row",
                      "gap": 26,
                      "alignItems": "end",
                      "children": [
                        {
                          "type": "frame",
                          "id": "c-tab-0",
                          "layout": "vertical",
                          "gap": 9,
                          "padding": [
                            0,
                            2
                          ],
                          "children": [
