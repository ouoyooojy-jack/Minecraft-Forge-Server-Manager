                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "c-stat-uptime",
                      "width": "fill_container",
                      "height": 76,
                      "fill": "$color.surface",
                      "cornerRadius": "$radius.card",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "layout": "vertical",
                      "gap": 4,
                      "padding": [
                        14,
                        16
                      ],
                      "justifyContent": "center",
                      "children": [
