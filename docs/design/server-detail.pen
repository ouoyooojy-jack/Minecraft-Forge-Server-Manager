                              "type": "icon",
                              "id": "c-btn-folder-icon",
                              "width": 16,
                              "height": 16,
                              "icon": "folder-open",
                              "library": "lucide",
                              "fill": "$color.muted"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "c-btn-more",
                          "width": 38,
                          "height": 38,
                          "fill": "$color.surface",
                          "cornerRadius": "$radius.button",
                          "stroke": "$color.border",
                          "strokeWidth": 1,
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "c-btn-more-icon",
                              "width": 16,
                              "height": 16,
                              "icon": "ellipsis",
                              "library": "lucide",
                              "fill": "$color.muted"
                            }
                          ]
