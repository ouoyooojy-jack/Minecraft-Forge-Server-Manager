                              "type": "text",
                              "id": "c-log-0",
                              "fill": "$color.muted",
                              "content": "[12:04:11] [Server thread/INFO]: Starting minecraft server version 1.20.1",
                              "fontFamily": "JetBrains Mono",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-log-1",
