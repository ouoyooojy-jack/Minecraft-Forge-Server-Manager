{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "detail-console",
      "x": 0,
      "y": 0,
      "theme": {
        "mode": "light"
      },
      "clip": true,
      "width": 1280,
      "height": 720,
      "fill": "$color.bg",
      "cornerRadius": 10,
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "detail-console-titlebar",
          "width": "fill_container",
          "gap": 10,
          "padding": [
            0,
            14,
            0,
            18
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "detail-console-tb-name",
              "fill": "$color.muted",
              "content": "Mc Server Manager",
              "fontFamily": "Inter",
              "fontSize": "$font.size.small",
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "detail-console-tb-controls",
              "gap": 18,
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "detail-console-tb-moon",
                  "width": 15,
                  "height": 15,
                  "icon": "moon",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "detail-console-tb-min",
                  "width": 15,
                  "height": 15,
                  "icon": "minus",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "detail-console-tb-max",
                  "width": 13,
                  "height": 13,
                  "icon": "square",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "detail-console-tb-x",
                  "width": 15,
                  "height": 15,
                  "icon": "x",
                  "library": "lucide",
                  "fill": "$color.muted"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "detail-console-body",
          "width": "fill_container",
          "height": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "detail-console-sidebar",
              "height": "fill_container",
              "fill": "$color.rail",
              "layout": "vertical",
              "gap": 10,
              "padding": [
                18,
                0
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "detail-console-sb-menu",
                  "width": 19,
                  "height": 19,
                  "icon": "menu",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "detail-console-sb-home",
                  "width": 19,
                  "height": 19,
                  "icon": "house",
                  "library": "lucide",
                  "fill": "$color.accent"
                },
                {
                  "type": "icon",
                  "id": "detail-console-sb-dl",
                  "width": 19,
                  "height": 19,
                  "icon": "download",
                  "library": "lucide",
                  "fill": "$color.muted"
                },
                {
                  "type": "icon",
                  "id": "detail-console-sb-set",
                  "width": 19,
                  "height": 19,
                  "icon": "settings",
                  "library": "lucide",
                  "fill": "$color.muted"
                }
              ]
            },
            {
              "type": "frame",
              "id": "detail-console-content",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "padding": [
                20,
                28,
                24,
                28
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "c-back",
                  "gap": 5,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "c-back-icon",
                      "width": 15,
                      "height": 15,
                      "icon": "chevron-left",
                      "library": "lucide",
                      "fill": "$color.muted"
                    },
                    {
                      "type": "text",
                      "id": "c-back-label",
                      "fill": "$color.muted",
                      "content": "所有伺服器",
                      "fontFamily": "Inter",
                      "fontSize": "$font.size.small",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "c-header",
                  "width": "fill_container",
                  "gap": 10,
                  "justifyContent": "space_between",
                  "alignItems": "end",
                  "children": [
                    {
                      "type": "frame",
                      "id": "c-head-left",
                      "layout": "vertical",
                      "gap": 8,
                      "children": [
                        {
                          "type": "frame",
                          "id": "c-head-title",
                          "gap": 14,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "c-name",
                              "fill": "$color.fg",
                              "content": "Vanilla Survival",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.hero",
                              "fontWeight": "700"
                            },
                            {
                              "type": "frame",
                              "id": "c-state",
                              "height": 26,
                              "fill": "$color.green_soft",
                              "cornerRadius": "$radius.pill",
                              "gap": 7,
                              "padding": [
                                5,
                                11
                              ],
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "c-state-dot",
                                  "width": 7,
                                  "height": 7,
                                  "fill": "$color.green",
                                  "cornerRadius": "$radius.pill"
                                },
                                {
                                  "type": "text",
                                  "id": "c-state-label",
                                  "fill": "$color.green",
                                  "content": "執行中",
                                  "fontFamily": "Inter",
                                  "fontSize": "$font.size.small",
                                  "fontWeight": "500"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "c-meta",
                          "gap": 8,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "c-meta-ver",
                              "fill": "$color.muted",
                              "content": "Minecraft 1.20.1",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-meta-d1",
                              "fill": "$color.faint",
                              "content": "·",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-meta-forge",
                              "fill": "$color.muted",
                              "content": "Forge 47.2.0",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-meta-d2",
                              "fill": "$color.faint",
                              "content": "·",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-meta-port",
                              "fill": "$color.muted",
                              "content": ":25565",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-meta-d3",
                              "fill": "$color.faint",
                              "content": "·",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "c-meta-path",
                              "fill": "$color.faint",
                              "content": "servers\\vanilla-survival",
                              "fontFamily": "JetBrains Mono",
                              "fontSize": "$font.size.small",
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "c-actions",
                      "gap": 10,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "c-btn-stop",
                          "height": 38,
                          "fill": "$color.red_soft",
                          "cornerRadius": "$radius.button",
                          "gap": 8,
                          "padding": [
                            0,
                            16
                          ],
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "c-btn-stop-icon",
                              "width": 15,
                              "height": 15,
                              "icon": "square",
                              "library": "lucide",
                              "fill": "$color.red"
                            },
                            {
                              "type": "text",
                              "id": "c-btn-stop-label",
                              "fill": "$color.red",
                              "content": "停止",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.body",
                              "fontWeight": "500"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "c-btn-restart",
                          "height": 38,
                          "fill": "$color.surface",
                          "cornerRadius": "$radius.button",
                          "stroke": "$color.border",
                          "strokeWidth": 1,
                          "gap": 8,
                          "padding": [
                            0,
                            16
                          ],
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "c-btn-restart-icon",
                              "width": 15,
                              "height": 15,
                              "icon": "rotate-cw",
                              "library": "lucide",
                              "fill": "$color.fg"
                            },
                            {
                              "type": "text",
                              "id": "c-btn-restart-label",
                              "fill": "$color.fg",
                              "content": "重啟",
                              "fontFamily": "Inter",
                              "fontSize": "$font.size.body",
                              "fontWeight": "500"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "c-btn-folder",
                          "width": 38,
                          "height": 38,
                          "fill": "$color.surface",
                          "cornerRadius": "$radius.button",
                          "stroke": "$color.border",
                          "strokeWidth": 1,
                          "justifyContent": "center",
                          "alignItems": "center",
