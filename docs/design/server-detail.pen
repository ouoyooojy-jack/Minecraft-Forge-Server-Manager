                      ]
                    },
                    {
                      "type": "frame",
                      "id": "c-tabs-rule",
                      "layoutPosition": "absolute",
                      "x": 0,
                      "y": 32,
                      "width": "fill_container(1160)",
                      "height": 1,
                      "fill": "$color.border"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "c-console",
                  "width": "fill_container",
                  "height": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "c-log",
                      "clip": true,
                      "width": "fill_container",
                      "height": "fill_container",
                      "fill": "$color.surface",
                      "cornerRadius": "$radius.card",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "layout": "vertical",
                      "children": [
                        {
                          "type": "frame",
                          "id": "c-log-bar",
                          "width": "fill_container",
                          "height": 42,
                          "stroke": "$color.border",
                          "strokeWidth": {
                            "bottom": 1
                          },
                          "gap": 10,
                          "padding": [
                            0,
                            16
                          ],
                          "justifyContent": "space_between",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "frame",
                              "id": "c-log-bar-left",
                              "gap": 7,
