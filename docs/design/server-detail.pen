                      "strokeWidth": 1,
                      "layout": "vertical",
                      "gap": 4,
                      "padding": [
                        14,
                        16
                      ],
                      "justifyContent": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "c-stat-players-label",
                          "fill": "$color.muted",
                          "content": "線上玩家",
                          "fontFamily": "Inter",
                          "fontSize": "$font.size.tiny",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "c-stat-players-val",
                          "gap": 5,
                          "alignItems": "center",
